{
  "name": "auto-podcast-editor",
  "version": "0.1.1",
  "description": "Local desktop editor for automating podcast cuts, captions, and exports",
  "author": "Auto Podcast Editor",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark:whisper": "node --experimental-strip-types scripts/run-whisper-benchmark.ts",
    "candidate:e2e": "node --experimental-strip-types scripts/run-product-candidate.ts",
    "gate:product": "node --experimental-strip-types scripts/run-product-gate.ts",
    "performance:gate": "node --experimental-strip-types scripts/run-performance-gate.ts",
    "audio:gate": "node --experimental-strip-types scripts/run-audio-stem-gate.ts",
    "golden:video": "node --experimental-strip-types scripts/compare-golden-video.ts",
    "golden:player": "npm run dist && node --experimental-strip-types scripts/capture-player-golden.ts",
    "build:manifest": "node --experimental-strip-types scripts/write-build-manifest.ts",
    "runtime:payload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-runtime-payload.ps1",
    "runtime:split": "node --experimental-strip-types scripts/split-runtime-file.ts",
    "runtime:manifest": "node --experimental-strip-types scripts/write-runtime-manifest.ts",
    "installer:online": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-online-installer.ps1",
    "bundle:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-offline-bundle.ps1",
    "install:offline-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-offline-bundle.ps1",
    "dist": "electron-vite build",
    "installer": "npm run build:manifest && npm run dist && electron-builder --win nsis",
    "installer:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-installer.ps1"
  },
  "build": {
    "appId": "com.autopodcast.editor",
    "productName": "Auto Podcast Editor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "assets/**/*",
      "!assets/bin/**/*",
      "!assets/models/**/*",
      "!assets/remotion-browser/**/*",
      "!assets/sfx/**/*",
      "node_modules/react/**/*",
      "node_modules/react-dom/**/*",
      "node_modules/scheduler/**/*",
      "node_modules/loose-envify/**/*",
      "core/**/*",
      "src/remotion/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auto Podcast Editor"
    }
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/player": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
